# ========================
# SPRING
# ========================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# ========================
# DATABASE
# ========================
DB_URL=jdbc:mysql://localhost:3306/sobu?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=root
DB_PASSWORD=1234
SQL_INIT_MODE=always
DDL_AUTO=update

# ========================
# WEB
# ========================
APP_FRONTEND_BASE_URL=http://localhost:3000
SERVER_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:3000,https://sobu-jet.vercel.app
CORS_MAX_AGE=3600
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
MAX_IN_MEMORY_SIZE=10MB

# ========================
# JWT
# ========================
JWT_SECRET=3f9a8c1d7e5b4a2f9c6e8d1b7a3c5f2e9d4b6a1c8e7f5d3b2a9c1e6f8d4b7a2
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ========================
# ENCRYPTION / API
# ========================
ENCRYPTION_SECRET_KEY=9a7c5e3f1b2d4a6c8e0f3b5d7a9c1e2f
API_KEY=dev-api-key-8f3d2c1b7a6e5f4d

# ========================
# STORAGE
# ========================
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_DIR=uploads

# ========================
# GOOGLE OAUTH
# ========================
GOOGLE_CLIENT_ID=

# ========================
# INTEGRATIONS (LOCAL MODE)
# ========================
# Nhanh ERP is off by default. Enable only via the optional "nhanh" Spring
# profile plus the NHANH_* credentials (see application-nhanh.properties).
INTEGRATION_NHANH_ENABLED=false
VIETNAM_MAP_BASE_URL=https://provinces.open-api.vn/api
VIETNAM_MAP_CACHE_TTL_HOURS=720
LOCAL_SHIPPING_FLAT_FEE=30000

# ========================
# PAYOS
# ========================
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# Required in real mode: stable public HTTPS callback URL; startup confirms it with PayOS.
PAYOS_WEBHOOK_URL=http://localhost:8081/api/payos/webhooks/callback
PAYOS_GATEWAY_MODE=mock

# ========================
# MAIL
# ========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM_ADDRESS=

# ========================
# REDIS
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ========================
# PASSWORD RESET
# ========================
APP_FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password?token=
RESET_PASSWORD_SECRET_KEY=3f9a8c1d7e5b4a2f9c6e8d1b7a3c5f2e9d4b6a1c8e7f5d3b2a9c1e6f8d4b7a2
RESET_PASSWORD_TOKEN_EXPIRATION_MS=900000
RESET_PASSWORD_COOLDOWN_MS=60000
